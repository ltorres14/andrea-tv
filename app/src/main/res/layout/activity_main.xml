<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:focusable="false"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".ui.home.MainActivity"
    tools:deviceIds="tv">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_andreatv_home" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/search_action"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_action"
                android:contentDescription="@string/search"
                android:focusable="true"
                android:nextFocusRight="@id/settings_action"
                android:padding="11dp"
                android:src="@drawable/ic_search"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/settings_action"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_action"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:nextFocusLeft="@id/search_action"
                android:padding="11dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/white" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:background="@drawable/bg_featured"
            android:clipChildren="false"
            android:paddingStart="36dp"
            android:paddingTop="25dp"
            android:paddingEnd="36dp"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:alpha="0.15"
                android:fontFamily="sans-serif-black"
                android:text="A"
                android:textColor="@color/white"
                android:textSize="150sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/featured_label"
                    android:textAllCaps="true"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-light"
                    android:text="@string/featured_title"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/featured_metadata"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/play_action"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/bg_play_button"
                    android:drawableStart="@drawable/ic_play"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="22dp"
                    android:text="@string/play"
                    android:textAllCaps="false"
                    android:textColor="@color/play_button_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            style="@style/HomeSectionTitle"
            android:layout_marginTop="22dp"
            android:text="@string/popular_movies" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/popular_movies"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:overScrollMode="never"
            android:paddingStart="48dp"
            android:paddingTop="8dp"
            android:paddingEnd="48dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            tools:listitem="@layout/item_poster" />

        <TextView
            style="@style/HomeSectionTitle"
            android:layout_marginTop="4dp"
            android:text="@string/series" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/series"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:overScrollMode="never"
            android:paddingStart="48dp"
            android:paddingTop="8dp"
            android:paddingEnd="48dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            tools:listitem="@layout/item_poster" />
    </LinearLayout>
</ScrollView>
